{
  "description": "UGC Studio: settings hooks that sync the gallery, and a mod (ugc-studio.mjs) with the Higgsfield spend guard and the credits meter.",
  "modules": [
    "./ugc-studio.mjs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR:-.}/studio.json\" ] || sh \"${CLAUDE_PLUGIN_ROOT}/scripts/sincronizar.sh\" --resumen"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR:-.}/studio.json\" ] || sh \"${CLAUDE_PLUGIN_ROOT}/scripts/sincronizar.sh\""
          }
        ]
      }
    ]
  }
}
